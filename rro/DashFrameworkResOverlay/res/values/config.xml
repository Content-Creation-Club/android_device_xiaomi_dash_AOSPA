<resources>
    <string name="config_mainDisplayShape" translatable="false">M20 0h1240s20 0 20 20v2732s0 20 -20 20h-1240s-20 0 -20 -20v-2732s0 -20 20 -20</string>
    <!-- DashLED handles ring notifications. Keep the standard notification
         and attention producers disabled while retaining the stock HAL. -->

    <!-- Let NotificationManager apply the device default and persist user
         revocations; the LED app must never rewrite listener grants. -->

    <!-- Always-on display is opt-in and independent of DashWake gestures. -->
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- The retained MediaTek overlay sets the legacy doze brightness to 5.
         Android 16's display stack prefers the float resource, whose platform
         default is 0.0, so provide the exact float equivalent of 5 here. -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.015748031</item>

    <!-- HyperOS points this at its proprietary AlwaysOnDisplay package, which
         is absent from LineageOS. Product overlays outrank the retained vendor
         overlay, so route doze back to SystemUI. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <!-- Night Light UI/scheduling is retained; DashEyeCare drives vendor feature 3.
         Set every channel polynomial to 1 so the framework cannot double-tint. -->
</resources>
