/(system_ext|system/system_ext)/bin/dash-displayfeature-compat  u:object_r:dash_displayfeature_compat_exec:s0
/dev/disp_feature  u:object_r:vendor_displayfeature_device:s0

# Charging thresholds must survive ueventd restorecon: stock vendor_file_contexts
# labels the whole battery dir sysfs_battery_supply, and every charger uevent
# re-applies it, overriding the genfscon in genfs_contexts. This exact-path
# entry wins on longest stem and makes the restorecon assign our label
# instead, so dash_health keeps access across uevents.
