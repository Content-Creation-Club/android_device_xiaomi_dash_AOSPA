type bsg_device, dev_type;

recovery_only(`
    # The retained MTK HAL switches UFS boot LUN through SG_IO when selecting a slot.
    allow hal_bootctl_default bsg_device:chr_file rw_file_perms;
    allowxperm hal_bootctl_default bsg_device:chr_file ioctl { 0x2285 };
')
