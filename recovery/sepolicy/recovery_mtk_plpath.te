# This recovery-domain helper writes vendor properties consumed by init.
vendor_public_prop(vendor_recovery_mtk_plpath_prop)

recovery_only(`
    set_prop(recovery, vendor_recovery_mtk_plpath_prop)
    # The helper reads UFS LUN information through /sys/bus/scsi/devices.
    allow recovery sysfs:file r_file_perms;
')
