type recovery_touch_device, dev_type;
type sysfs_recovery_touch, fs_type, sysfs_type;
type sysfs_recovery_firmware_path, fs_type, sysfs_type;
type proc_recovery_touch, fs_type, proc_type;

recovery_only(`
    # The host algorithm mmaps raw frames and reports coordinates through evdev.
    allow recovery recovery_touch_device:chr_file rw_file_perms;
    allowxperm recovery recovery_touch_device:chr_file ioctl { 0x5400-0x5405 };
    allow recovery input_device:chr_file w_file_perms;
    allowxperm recovery input_device:chr_file ioctl { 0x4500-0x45ff };
    r_dir_file(recovery, sysfs_recovery_touch)
    allow recovery sysfs_recovery_touch:file w_file_perms;
    allow recovery proc_recovery_touch:file r_file_perms;
    allow recovery self:global_capability_class_set sys_nice;
    allow init recovery_touch_device:chr_file getattr;
    allow init sysfs_recovery_firmware_path:file w_file_perms;
')
