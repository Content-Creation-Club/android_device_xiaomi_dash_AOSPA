on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "16701000.usb0"
    setprop sys.usb.ffs.aio_compat 1

    # Set the firmware path before loading touch modules.
    write /sys/module/firmware_class/parameters/path /ram/firmware,/vendor/firmware,/odm/firmware
    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /lib/modules xiaomi_touch_dash nt38771_touch_dash

on boot
    wait /dev/xiaomi-touch 10
    start recovery-touch-bridge

service recovery-touch-bridge /system/bin/touch_report_debug
    class core
    user root
    group root input
    capabilities SYS_NICE
    seclabel u:r:recovery:s0
    disabled
