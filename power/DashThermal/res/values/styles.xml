<resources>
    <!-- Use the platform Settings theme for native Toolbar menus and SearchView. -->
    <style name="ThemeOverlay.DashThermal.Toolbar" parent="@android:style/Theme.DeviceDefault.Settings">
        <item name="android:colorAccent">@color/settingslib_materialColorPrimary</item>
        <item name="android:colorControlNormal">@color/settingslib_materialColorPrimary</item>
    </style>
    <!-- Match Settings SPA's Material 3 DropdownMenu surface and placement. -->
    <style name="ThemeOverlay.DashThermal.Popup" parent="ThemeOverlay.DashThermal.Toolbar">
        <item name="android:actionOverflowMenuStyle">@style/Widget.DashThermal.PopupMenu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.DashThermal.PopupMenu</item>
    </style>
    <style name="Widget.DashThermal.PopupMenu" parent="@android:style/Widget.Material.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">3dp</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
    </style>
    <style name="TextAppearance.DashThermal.PopupMenu" parent="TextAppearance.SettingsLib.BodyLarge">
        <item name="android:textColor">@color/settingslib_materialColorOnSurface</item>
    </style>
</resources>
