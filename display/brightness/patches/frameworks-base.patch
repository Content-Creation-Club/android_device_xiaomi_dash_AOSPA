+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display;
+
+/**
+ * Optional device-specific rate policy for an ordinary automatic-brightness ramp.
+ *
+ * <p>Implementations are constructed by {@link DisplayPowerController} with
+ * {@code (Context, DisplayDeviceConfig)}. A non-finite or non-positive rate declines the current
+ * transition/frame and leaves the generic {@link RampAnimator} behavior in effect.</p>
+ */
+public interface DeviceBrightnessRampPolicy {
+    /**
+     * Returns a linear-brightness-per-second rate for the requested channel, or {@link Float#NaN}
+     * to decline the transition/frame. This is called every animation frame and intentionally
+     * returns a primitive to avoid allocation in the frame loop.
+     *
+     * @param propertyName the animated brightness channel/property identity
+     * @param transitionStartLinearBrightness the linear brightness at transition start
+     * @param currentLinearBrightness the current linear brightness for this frame
+     * @param targetLinearBrightness the exact linear brightness target
+     */
+    float getRate(String propertyName, float transitionStartLinearBrightness,
+            float currentLinearBrightness, float targetLinearBrightness);
+}
