+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display;
+
+/** Optional device policy for the lifecycle of the automatic-brightness user point. */
+public interface DeviceShortTermModelPolicy {
+    /** Records an interactive-policy transition. Times use elapsed realtime milliseconds. */
+    void onDisplayPolicyChanged(boolean interactive, float ambientLux, long elapsedRealtimeMillis);
+
+    /**
+     * Evaluates an invalidated user point. A handled result bypasses the platform lux-window reset.
+     * A finite replacement nit value asks the controller to reinsert the same lux anchor at that
+     * brightness; NaN retains the existing point without revalidating it.
+     */
+    Evaluation evaluate(float ambientLux, float userLux, float userNits,
+            long elapsedRealtimeMillis);
+
+    record Evaluation(boolean handled, float replacementNits) {
+        public static final Evaluation NOT_HANDLED = new Evaluation(false, Float.NaN);
+        public static final Evaluation HANDLED = new Evaluation(true, Float.NaN);
+    }
+}
