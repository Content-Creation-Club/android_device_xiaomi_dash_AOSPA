android_app {
    name: "DashPowerKeeperCompat",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    static_libs: ["dash-thermal-client"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: { enabled: true },
}
