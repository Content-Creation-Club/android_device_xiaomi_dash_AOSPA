service dash-health /system_ext/bin/hw/dash-health
    class hal
    user system
    group system

on post-fs-data
    mkdir /data/misc/dash-health 0770 system system
    restorecon_recursive /data/misc/dash-health
    chown system system /sys/class/power_supply/battery/smart_chg
    chmod 0660 /sys/class/power_supply/battery/smart_chg

on property:sys.boot_completed=1
    chown system system /sys/class/power_supply/battery/smart_chg
    chmod 0660 /sys/class/power_supply/battery/smart_chg
