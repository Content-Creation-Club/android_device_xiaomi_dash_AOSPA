# system_ext is parsed before vendor. Keep the stock service's configuration
# with the wakelock group required by its ChargerLogger thread; the later
# non-override vendor definition is ignored. Override also permits its duplicate
# AIDL interface declaration. The stock post-fs action still starts this service.
service vendor.misys.common /vendor/bin/hypsys_vendor
    override
    class main
    user system
    group system root log cache everybody media_rw debuggerd wakelock
    file /dev/kmsg r
    interface aidl vendor.xiaomi.hardware.misys.common.IMiSysImpl/default
    disabled

# Disable Xiaomi network acceleration before its vendor service classes start.
on init
    stop minetd
    stop slad
    stop sla-service-hal-2-0
    stop vendor.xiaomi.aidl.minet
    stop vendor.xiaomi.aidl.miwill

# Stock property actions can explicitly start disabled services.
on property:init.svc.minetd=running
    stop minetd

on property:init.svc.slad=running
    stop slad

on property:init.svc.sla-service-hal-2-0=running
    stop sla-service-hal-2-0

on property:init.svc.vendor.xiaomi.aidl.minet=running
    stop vendor.xiaomi.aidl.minet

on property:init.svc.vendor.xiaomi.aidl.miwill=running
    stop vendor.xiaomi.aidl.miwill

# The retained stock fstab mounts mi_ext directories over Lineage-owned
# framework partitions. Remove every mi_ext-backed overlay before
# PackageManager scans them, then detach the source partition so later stock
# init actions cannot recreate those mounts.
on post-fs
    umount /system_ext/etc/permissions
    umount /system/etc/permissions
    umount /system/etc/sysconfig
    umount /system/priv-app
    umount /system/app
    umount /product/etc/security
    umount /product/etc/preferred-apps
    umount /product/etc/precust_theme
    umount /product/etc/permissions
    umount /product/etc/sysconfig
    umount /product/data-app
    umount /product/opcust
    umount /product/media
    umount /product/framework
    umount /product/bin
    umount /product/lib64
    umount /product/lib
    umount /product/priv-app
    umount /product/app
    umount /product/overlay
    umount /product/usr
    umount /mi_ext
    umount /mnt/vendor/mi_ext

# The retained Xiaomi displayfeature HAL opens this stock ueventd path, while
# the AOSP ueventd configuration exposes the same mi_display cdev at
# /dev/disp_feature. Use a hard link so the stock pathname resolves to that
# same already-labelled device node.
service dash-displayfeature-compat /system_ext/bin/dash-displayfeature-compat
    class core
    user root
    group root graphics
    disabled
    oneshot

on early-boot
    mkdir /dev/mi_display 0755 root graphics
    wait /dev/disp_feature 5
    exec_start dash-displayfeature-compat
    chown root graphics /dev/mi_display/disp_feature
    chmod 0666 /dev/mi_display/disp_feature

# Vendor disables MGLRU during post-fs-data; enable it after that stage.
on boot
    write /sys/kernel/mm/lru_gen/enabled 7
    # Override transparent_hugepage=never for applications requesting THP.
    write /sys/kernel/mm/transparent_hugepage/enabled madvise
